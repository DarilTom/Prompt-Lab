# ==============================================================================
# Prompt Lab Backend — Environment Configuration Template
# ==============================================================================

# Django Security
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=True

# Host & Origin Configuration
# On Render, RENDER_EXTERNAL_HOSTNAME is automatically detected and added.
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# ------------------------------------------------------------------------------
# Option A: Production Neon / Hosted PostgreSQL (used when DATABASE_URL is set)
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option B: Local Development PostgreSQL (used when DATABASE_URL is omitted)
DB_NAME=promptlab
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

# Ollama Service Configuration
# ------------------------------------------------------------------------------
# In local development: http://localhost:11434 (leave tunnel username/password blank)
# For hosted Render deployment connecting to local PC via ngrok tunnel:
# Set OLLAMA_BASE_URL to your ngrok URL (e.g. https://your-tunnel-subdomain.ngrok-free.app)
# and configure HTTP Basic Auth credentials if tunnel is password-protected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_TUNNEL_USERNAME=
OLLAMA_TUNNEL_PASSWORD=

# Email Configuration
# Note: Render Free blocks outbound SMTP on port 587. For production password resets
# on Render Free, an HTTPS-based email provider (e.g., Resend, SendGrid, Mailgun)
# or compatible API is required. Local development can use SMTP (587) or console email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
